@@ -573,0 +574,6 @@ def responses_to_openai_body(body: dict) -> dict:
+    # Keep Codex's requested effort private to the Responses route until it
+    # knows which Ollama node won. That route can then validate an exact
+    # model-advertised value before adding Ollama's native `think` field.
+    reasoning = body.get("reasoning")
+    if isinstance(reasoning, dict) and reasoning.get("effort") is not None:
+        out["_codex_reasoning_effort"] = reasoning["effort"]
diff --git a/src/fleet_manager/server/routes/responses_compat.py b/src/fleet_manager/server/routes/responses_compat.py
index 5b49975..262ba58 100644
--- a/src/fleet_manager/server/routes/responses_compat.py
+++ b/src/fleet_manager/server/routes/responses_compat.py
@@ -68,0 +69,18 @@ def _error(status: int, message: str, etype: str = "invalid_request_error") -> J
+def _apply_requested_reasoning_effort(body: dict, effort, controls: dict | None) -> None:
+    """Map explicit Codex effort only when Ollama advertises it verbatim."""
+    if effort is None:
+        return
+    if not isinstance(effort, str) or not effort:
+        raise ValueError("reasoning.effort must be a non-empty string")
+    values = controls.get("values") if isinstance(controls, dict) else None
+    if not isinstance(values, list):
+        values = []
+    if effort not in values:
+        available = ", ".join(repr(value) for value in values) or "none reported"
+        raise ValueError(
+            f"Ollama model does not advertise reasoning effort {effort!r}; "
+            f"accepted think values: {available}"
+        )
+    body["think"] = effort
+
+
@@ -138,0 +157 @@ async def responses(request: Request):
+    requested_reasoning_effort = openai_body.pop("_codex_reasoning_effort", None)
@@ -238,0 +258,8 @@ async def responses(request: Request):
