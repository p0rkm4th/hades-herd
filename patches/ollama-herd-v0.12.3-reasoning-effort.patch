+        controls = await proxy.get_thinking_controls(winner.node_id, actual_model)
+        try:
+            _apply_requested_reasoning_effort(
+                inference_req.raw_body, requested_reasoning_effort, controls
+            )
+        except ValueError as exc:
+            return _error(400, str(exc))
diff --git a/src/fleet_manager/server/streaming.py b/src/fleet_manager/server/streaming.py
index 755e860..e2d4ff6 100644
--- a/src/fleet_manager/server/streaming.py
+++ b/src/fleet_manager/server/streaming.py
@@ -178,0 +179,4 @@ class StreamingProxy:
+        # Short-lived metadata cache for explicit Codex reasoning controls.
+        # The selected node/model pair matters because Ollama levels vary by
+        # model and duplicate models can have different backend metadata.
+        self._thinking_controls: dict[tuple[str, str], tuple[float, dict | None]] = {}
@@ -232,0 +237 @@ class StreamingProxy:
+            self._clear_thinking_controls(node_id)
@@ -241,0 +247,37 @@ class StreamingProxy:
+    async def get_thinking_controls(self, node_id: str, model: str) -> dict | None:
+        """Read the selected Ollama model's advertised thinking values.
+
+        This runs only when a client explicitly requests reasoning effort. A
+        short cache avoids an extra metadata request for every streamed turn.
+        Missing or malformed metadata means the request cannot be applied.
+        """
+        key = (node_id, model)
+        now = time.monotonic()
+        cached = self._thinking_controls.get(key)
+        if cached and now - cached[0] < 60:
+            return cached[1]
+        client = self._get_client(node_id)
+        try:
+            response = await client.post(
+                "/api/show",
+                json={"model": model},
+                timeout=httpx.Timeout(connect=5.0, read=10.0, write=5.0, pool=5.0),
+            )
+            response.raise_for_status()
+            shown = response.json()
+        except (httpx.HTTPError, ValueError):
+            self._thinking_controls.pop(key, None)
+            return None
+        thinking = shown.get("thinking") if isinstance(shown, dict) else None
+        values = thinking.get("values") if isinstance(thinking, dict) else None
+        default = thinking.get("default") if isinstance(thinking, dict) else None
+        valid = (
+            isinstance(values, list)
+            and bool(values)
+            and all(type(value) in (bool, str) for value in values)
+            and (default is None or (type(default) in (bool, str) and default in values))
+        )
+        controls = {"values": values, "default": default} if valid else None
+        self._thinking_controls[key] = (now, controls)
+        return controls
+
@@ -254,0 +297,5 @@ class StreamingProxy:
+        self._clear_thinking_controls(node_id)
+
+    def _clear_thinking_controls(self, node_id: str):
+        for key in [key for key in self._thinking_controls if key[0] == node_id]:
+            del self._thinking_controls[key]
diff --git a/tests/test_server/test_responses_route.py b/tests/test_server/test_responses_route.py
