--- a/tests/test_server/test_responses_route.py
+++ b/tests/test_server/test_responses_route.py
@@ -54,0 +55,14 @@ def client():
+def test_requested_reasoning_effort_requires_exact_advertised_value():
+    body = {"model": "qwen3.8:27b", "messages": []}
+    responses_compat._apply_requested_reasoning_effort(
+        body, "xhigh", {"values": [False, "low", "medium", "xhigh"]}
+    )
+    assert body["think"] == "xhigh"
+    with pytest.raises(ValueError, match="accepted think values"):
+        responses_compat._apply_requested_reasoning_effort(
+            {}, "high", {"values": [False, "low", "medium", "xhigh"]}
+        )
+    with pytest.raises(ValueError, match="none reported"):
+        responses_compat._apply_requested_reasoning_effort({}, "low", None)
+
+
