+def test_explicit_empty_offered_set_suppresses_nonstream_tool_call():
+    from fleet_manager.server.responses_translator import build_responses_object
+
+    req = responses_to_openai_body({"model": "m", "input": "go", "tools": []})
+    assert "tools" not in req
+    assert req["_known_tool_names"] == []
+    obj = build_responses_object(
+        model="m", text="",
+        tool_calls=[{"function": {"name": "exec_command", "arguments": {"cmd": "true"}}}],
+        known_names=set(req["_known_tool_names"]), input_tokens=1, output_tokens=1,
+    )
+    assert not any(item["type"] == "function_call" for item in obj["output"])
+    assert "No tool was run" in obj["output"][0]["content"][0]["text"]
+
+
+def test_explicit_empty_offered_set_suppresses_stream_tool_call():
+    state = ResponsesSSEState(model="m", known_names=set())
+    chunk = json.dumps({"message": {"tool_calls": [
+        {"function": {"name": "exec_command", "arguments": {"cmd": "true"}}}
+    ]}, "done": True, "done_reason": "stop"})
+    events = [
+        json.loads(frame.split("data: ", 1)[1])
+        for frame in ollama_chunk_to_responses_events(chunk, state)
+    ]
+    assert not any(event.get("item", {}).get("type") == "function_call" for event in events)
+    assert any(
+        event["type"] == "response.output_text.delta" and "No tool was run" in event["delta"]
+        for event in events
+    )
+    assert events[-1]["type"] == "response.completed"
+
+
