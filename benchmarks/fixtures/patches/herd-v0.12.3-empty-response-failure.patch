diff --git a/tests/test_server/test_responses_empty_completion_diagnostic.py b/tests/test_server/test_responses_empty_completion_diagnostic.py
new file mode 100644
index 0000000..87d615e
--- /dev/null
+++ b/tests/test_server/test_responses_empty_completion_diagnostic.py
@@ -0,0 +1,32 @@
+"""Candidate behavior: do not label an empty model turn as a successful response."""
+import json
+
+from fleet_manager.server.responses_translator import (
+    ResponsesSSEState,
+    accumulate_responses_object,
+    ollama_chunk_to_responses_events,
+)
+
+EMPTY = json.dumps({
+    "model": "test:model",
+    "message": {"role": "assistant", "content": "", "thinking": "private"},
+    "done": True,
+    "done_reason": "stop",
+})
+
+
+def test_streaming_empty_completion_is_explicit_failure():
+    state = ResponsesSSEState(model="test:model")
+    events = [json.loads(line[6:]) for event in ollama_chunk_to_responses_events(EMPTY, state)
+              for line in event.splitlines() if line.startswith("data: ")]
+    assert events[-1]["type"] == "response.failed"
+    assert events[-1]["response"]["output"] == []
+    assert "no visible content" in events[-1]["response"]["error"]["message"]
+    assert "private" not in json.dumps(events)
+
+
+def test_nonstreaming_empty_completion_is_explicit_failure():
+    response = accumulate_responses_object([EMPTY], model="test:model")
+    assert response["status"] == "failed"
+    assert response["output"] == []
+    assert "no visible content" in response["error"]["message"]
